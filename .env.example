# ============================================================
# BANCO DE DADOS — Supabase PostgreSQL
# ============================================================
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ============================================================
# SUPABASE — Auth + Storage
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SUPABASE_SERVICE_ROLE_KEY]"

# ============================================================
# NEXTAUTH — Autenticação
# ============================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="[GERE_COM: openssl rand -base64 32]"

# ============================================================
# STRIPE — Pagamentos
# ============================================================
STRIPE_SECRET_KEY="sk_test_[...]"
STRIPE_WEBHOOK_SECRET="whsec_[...]"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_[...]"

# Preços dos pacotes de créditos (IDs do Stripe)
STRIPE_PRICE_PACK_5="price_[...]"    # 5 créditos
STRIPE_PRICE_PACK_10="price_[...]"   # 10 créditos
STRIPE_PRICE_PACK_25="price_[...]"   # 25 créditos
STRIPE_PRICE_PACK_50="price_[...]"   # 50 créditos
STRIPE_PRICE_PACK_20="price_[...]"   # 20 créditos (alvo do cupom 50% off)

# Premium — Relatório individual + PDI
STRIPE_PRICE_PREMIUM_REPORT="price_[...]"
PREMIUM_REPORT_PRICE_CENTS="4700"          # R$ 47,00 (fallback se PRICE_ID ausente)
NEXT_PUBLIC_PREMIUM_PRICE_BRL="47,00"

# Cupom de re-engajamento (50% off no pacote de 20)
STRIPE_COUPON_50_OFF="PASSAPORTE50"

# ============================================================
# CRON (Railway/Vercel) — Bearer token p/ autorizar /api/cron/*
# ============================================================
CRON_SECRET="[GERE_COM: openssl rand -base64 32]"

# ============================================================
# MANYCHAT — Tags de perfil + outreach de re-engajamento
# ============================================================
# Token de API do ManyChat (Settings → API → Generate)
MANYCHAT_API_TOKEN="[manychat_token]"
# IDs dos Custom Fields criados no ManyChat
MANYCHAT_FIELD_EXTERNAL_ID="[field_id]"
MANYCHAT_FIELD_COUPON="[field_id]"
MANYCHAT_FIELD_COUPON_URL="[field_id]"
MANYCHAT_FIELD_TRIGGER="[field_id]"
MANYCHAT_FIELD_TEST_TYPE="[field_id]"
MANYCHAT_FIELD_PROFILE_KEY="[field_id]"
MANYCHAT_FIELD_RESULT_URL="[field_id]"
# Flow_ns do flow de re-engajamento (Cupom 50% off)
MANYCHAT_FLOW_REENGAGE="content_[...]"

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Psique — Mapa Comportamental"

# ============================================================
# RESEND — E-mails transacionais
# ============================================================
# 1. Crie conta em https://resend.com (gratuito até 3.000/mês)
# 2. Domains → Add Domain → mapacomportamental.com
# 3. Cole os DNS records (TXT/MX/CNAME) no painel da GoDaddy
# 4. Verify no Resend (depois da propagação)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@mapacomportamental.com"
RESEND_FROM_NAME="Mapa Comportamental"

# E-mail do admin (recebe cópia das notificações de teste concluído)
ADMIN_EMAIL="kenio.araujo@live.com"

# ============================================================
# ANTHROPIC — devolutivas e relatórios consultivos
# ============================================================
# Sem esta chave, todo relatório enriquecido falha em silêncio:
# bundle, relatório integrado, narrativa do NR-1, PDI e perfil de vaga.
ANTHROPIC_API_KEY="sk-ant-..."

# ============================================================
# HOTMART — provisionamento de créditos por venda de afiliado
# ============================================================
# Mesmo valor do campo Hottok no painel do Hotmart. Sem ele, o webhook
# recusa toda notificação e a venda não entrega crédito nenhum.
HOTMART_HOTTOK="[hottok_do_painel]"
HOTMART_ALERT_EMAIL="kenio.araujo@live.com"

# ============================================================
# STRIPE — assinaturas PJ (separado do webhook de crédito avulso)
# ============================================================
STRIPE_WEBHOOK_SECRET_SUBSCRIPTION="whsec_[...]"
STRIPE_PRICE_INDIVIDUAL="price_[...]"    # R$ 97/mês  · 1 colaborador
STRIPE_PRICE_EQUIPE_5="price_[...]"      # R$ 447/mês · 5 colaboradores
STRIPE_PRICE_EQUIPE_10="price_[...]"     # R$ 797/mês · 10 colaboradores
STRIPE_PRICE_EQUIPE_20="price_[...]"     # R$ 1.397/mês · 20 colaboradores
STRIPE_PRICE_EQUIPE_50="price_[...]"     # R$ 2.347/mês · 50 colaboradores
STRIPE_PRICE_ESSENCIAL="price_[...]"     # plano legado, não público
STRIPE_PRICE_PROFISSIONAL="price_[...]"  # plano legado, não público

# ============================================================
# OPCIONAIS
# ============================================================
NEXT_PUBLIC_LOGO_URL=""                  # logo alternativo nos PDFs
PUPPETEER_EXECUTABLE_PATH=""             # só em dev, se o Chrome não for achado sozinho

# ============================================================
# RESTAURAR NO RAILWAY — checklist
# ============================================================
# Nenhum valor de produção existe em arquivo local (.env.local é dev, com
# SQLite e localhost). Se as variáveis do serviço sumirem, a origem de cada
# uma é:
#   DATABASE_URL, DIRECT_URL, SUPABASE_*  → painel Supabase (Settings → Database / API)
#   STRIPE_*                              → dashboard Stripe (chaves, webhooks, prices)
#   RESEND_API_KEY                        → painel Resend (gerar nova)
#   ANTHROPIC_API_KEY                     → console.anthropic.com (gerar nova)
#   HOTMART_HOTTOK                        → painel Hotmart
#   MANYCHAT_*                            → painel ManyChat
#   NEXTAUTH_SECRET, CRON_SECRET          → gerar novos (desloga todo mundo, sem problema)
#   NEXT_PUBLIC_APP_URL                   → https://mapacomportamental.com
#   NEXTAUTH_URL                          → https://mapacomportamental.com
#
# ATENÇÃO: subir sem NEXTAUTH_SECRET não quebra o deploy — o app assume um
# segredo padrão que está público no GitHub e passa a aceitar sessão forjada.
# Confira as variáveis ANTES de aprovar o deploy, não depois.
