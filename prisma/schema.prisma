// ============================================================
// schema.prisma — PRODUÇÃO (PostgreSQL via Supabase)
// ============================================================
// Para desenvolvimento local, use schema.dev.prisma:
//   cp prisma/schema.dev.prisma prisma/schema.prisma
//   npx prisma db push && npm run db:seed
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // connection pooling (Supabase)
  directUrl = env("DIRECT_URL")     // conexão direta para migrations
}

// ============================================================
// EMPRESA (cliente do SaaS)
// ============================================================
model Company {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  type         String    @default("PJ") // PF | PJ
  phone        String?
  whatsapp     String?
  instagram    String?
  linkedin     String?
  birthDate    DateTime?

  // Endereço
  addressStreet String?
  addressCity   String?
  addressState  String?
  addressZip    String?

  // Dados profissionais
  jobTitle    String?
  companyName String?

  // Gamificação de onboarding
  isOnboardingCredited       Boolean @default(false)
  isProfileCompletedRewarded Boolean @default(false)

  active    Boolean  @default(true)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees              Employee[]
  assessments            Assessment[]
  creditBalance          CreditBalance?
  creditPurchases        CreditPurchase[]
  creditTransactions     CreditTransaction[]
  reports                Report[]
  bundleReports          BundleReport[]
  integratedReports      EmployeeIntegratedReport[]
  profileValidationCodes ProfileValidationCode[]
  // Passaporte de Autoconhecimento
  bonusGrants       BonusGrant[]
  reportUnlocks     ReportUnlock[]
  scheduledOutreach ScheduledOutreach[]
  // Frente C — Compliance NR-1 (Diagnostico Psicossocial)
  nr1Setores    NR1Setor[]
  nr1Coletas    NR1Coleta[]
  nr1Convites   NR1Convite[]
  nr1Respostas  NR1Resposta[]
  nr1Relatorios NR1Relatorio[]
  // Monetizacao B2B (assinatura)
  subscription  Subscription?
  // Gestao de Times (20-70-10 + Team Build)
  talentTeams   TalentTeam[]
  // Avaliacao de Lideranca (ascendente anonima)
  liderConvites  LiderConvite[]
  liderRespostas LiderResposta[]
}

// ============================================================
// CÓDIGO DE VALIDAÇÃO DE PERFIL (Gamificação +6 créditos)
// ============================================================
model ProfileValidationCode {
  id        String   @id @default(cuid())
  companyId String
  code      String   // 6 dígitos
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([code])
}

// ============================================================
// TOKEN DE RECUPERAÇÃO DE SENHA
// ============================================================
model PasswordResetToken {
  id        String   @id @default(cuid())
  companyId String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================
// FUNCIONÁRIO / AVALIADO
// ============================================================
model Employee {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String
  createdAt DateTime @default(now())

  company           Company                    @relation(fields: [companyId], references: [id])
  assessments       Assessment[]
  bundleReports     BundleReport[]
  integratedReports EmployeeIntegratedReport[]

  @@unique([companyId, email])
}

// ============================================================
// AVALIAÇÃO (instância de um teste)
// ============================================================
model Assessment {
  id          String    @id @default(cuid())
  companyId   String
  employeeId  String
  testType    String    // DISC | MBTI | ENNEAGRAM | TEMPERAMENT
  token       String    @unique
  status      String    @default("PENDING") // PENDING | SENT | COMPLETED | EXPIRED
  bundleId    String?   // agrupa assessments de um bundle
  bundleOrder Int?      // ordem no bundle: 1=DISC, 2=MBTI, 3=ENNEAGRAM, 4=TEMPERAMENT
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  company            Company             @relation(fields: [companyId], references: [id])
  employee           Employee            @relation(fields: [employeeId], references: [id])
  discAnswers        DiscAnswer[]
  mbtiAnswers        MbtiAnswer[]
  enneagramAnswers   EnneagramAnswer[]
  temperamentAnswers TemperamentAnswer[]
  result             Result?
  report             Report?
}

// ============================================================
// RESPOSTAS por tipo de teste
// ============================================================
model DiscAnswer {
  id           String @id @default(cuid())
  assessmentId String
  groupId      Int
  profileD     Int
  profileI     Int
  profileS     Int
  profileC     Int

  assessment Assessment @relation(fields: [assessmentId], references: [id])
}

model MbtiAnswer {
  id           String @id @default(cuid())
  assessmentId String
  questionId   Int
  scoreA       Int
  scoreB       Int

  assessment Assessment @relation(fields: [assessmentId], references: [id])
}

model EnneagramAnswer {
  id           String @id @default(cuid())
  assessmentId String
  questionId   Int
  value        Int    // 1–5

  assessment Assessment @relation(fields: [assessmentId], references: [id])
}

model TemperamentAnswer {
  id           String @id @default(cuid())
  assessmentId String
  questionId   Int
  selected     String // A | C | I | O

  assessment Assessment @relation(fields: [assessmentId], references: [id])
}

// ============================================================
// RESULTADO CALCULADO
// ============================================================
model Result {
  id             String   @id @default(cuid())
  assessmentId   String   @unique
  testType       String
  resultData     Json     // PostgreSQL suporta Json nativo
  primaryProfile String
  createdAt      DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  report     Report?
}

// ============================================================
// RELATÓRIO PDF
// ============================================================
model Report {
  id           String   @id @default(cuid())
  assessmentId String   @unique
  resultId     String   @unique
  companyId    String
  pdfUrl       String?
  createdAt    DateTime @default(now())

  assessment Assessment    @relation(fields: [assessmentId], references: [id])
  result     Result        @relation(fields: [resultId], references: [id])
  company    Company       @relation(fields: [companyId], references: [id])
  unlock     ReportUnlock?
}

// ============================================================
// SISTEMA DE CRÉDITOS
// ============================================================
model CreditBalance {
  id        String   @id @default(cuid())
  companyId String   @unique
  // saldo PAGO (Stripe) — sem expiração
  balance   Int      @default(0)
  // saldo BÔNUS (passaporte/gamificação) — cache de SUM(bonusGrants.remaining)
  bonusBalance       Int       @default(0)
  bonusNextExpiresAt DateTime?
  passportStatus     String    @default("INACTIVE") // ACTIVE | EXPIRED | CONSUMED | INACTIVE
  updatedAt          DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  bonusGrants BonusGrant[]

  @@index([bonusNextExpiresAt])
  @@index([passportStatus])
}

model CreditPurchase {
  id              String   @id @default(cuid())
  companyId       String
  stripeSessionId String   @unique
  amount          Int
  pricePaid       Int
  status          String   @default("PENDING") // PENDING | PAID | REFUNDED
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

model CreditTransaction {
  id          String    @id @default(cuid())
  companyId   String
  type        String    // PURCHASE | DEBIT | BONUS | EXPIRE | REFUND
  source      String    @default("PAID") // PAID | BONUS
  amount      Int
  description String    @default("")
  expiresAt   DateTime? // preenchido em type=BONUS
  grantId     String?   // FK p/ BonusGrant (opcional)
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, type])
  @@index([expiresAt])
}

// ============================================================
// DEVOLUTIVA INTEGRADA POR FUNCIONÁRIO (Frente B)
// Cruza TODOS os testes que o employee fez, escalando em profundidade:
//   - 2 testes  → BASIC      (~500 palavras)
//   - 3 testes  → SYNTHETIC  (~1000 palavras, 3 dimensões cruzadas)
//   - 4-5 testes → EXECUTIVE (~2000 palavras, radar + PDI)
//   - 6+ testes → PREMIUM    (~3500 palavras, mapa estratégico)
// ============================================================
model EmployeeIntegratedReport {
  id            String   @id @default(cuid())
  employeeId    String
  companyId     String
  status        String   @default("PENDING") // PENDING | GENERATING | COMPLETED | FAILED
  depth         String   @default("BASIC")   // BASIC | SYNTHETIC | EXECUTIVE | PREMIUM
  testCount     Int      @default(0)
  includedTests String?  @db.Text            // JSON array dos testTypes incluídos
  content       String?  @db.Text            // JSON com seções do relatório
  pdfUrl        String?
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@index([status])
}

// ============================================================
// RELATÓRIO CRUZADO DE BUNDLE (devolutiva integrada dos 4 testes)
// ============================================================
model BundleReport {
  id          String   @id @default(cuid())
  bundleId    String   @unique        // mesmo bundleId dos 4 assessments
  companyId   String
  employeeId  String
  status      String   @default("PENDING") // PENDING | GENERATING | COMPLETED | FAILED
  content     String?  @db.Text            // JSON com seções do relatório gerado por IA
  pdfUrl      String?                      // URL do PDF no Supabase Storage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

// ============================================================
// PASSAPORTE DE AUTOCONHECIMENTO — Bônus por lote (FIFO)
// Todo crédito não-comprado expira em 7 dias.
// ============================================================
model BonusGrant {
  id              String    @id @default(cuid())
  companyId       String
  creditBalanceId String
  source          String    // WELCOME_PASSPORT | PROFILE_COMPLETE | REFERRAL | GIFT | PROMO
  amount          Int
  remaining       Int
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime
  expiredAt       DateTime?
  description     String    @default("")

  creditBalance CreditBalance @relation(fields: [creditBalanceId], references: [id], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id])

  @@index([companyId, expiresAt])
  @@index([companyId, remaining, expiresAt])
}

// ============================================================
// Premium gate — desbloqueio individual de relatório
// ============================================================
model ReportUnlock {
  id              String   @id @default(cuid())
  reportId        String   @unique
  companyId       String
  stripeSessionId String?  @unique
  amountBrl       Int
  unlockedAt      DateTime @default(now())

  report  Report  @relation(fields: [reportId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// ============================================================
// Outreach (ManyChat) — agendamento e envio
// ============================================================
model ScheduledOutreach {
  id           String    @id @default(cuid())
  companyId    String
  type         String    // ZERO_BALANCE_DAY7 | FIRST_TEST_DAY7 | PASSPORT_EXPIRED
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("PENDING") // PENDING | SENT | FAILED | CANCELED
  attempts     Int       @default(0)
  payload      Json
  errorMsg     String?
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([status, scheduledFor])
  @@index([companyId, type])
}

// ============================================================
// FRENTE C - COMPLIANCE NR-1 (Diagnostico de Riscos Psicossociais)
// Arquitetura de anonimato blindado:
//   - NR1Convite (Tabela A): identidade do funcionario + token de acesso
//   - NR1Resposta (Tabela B): respostas brutas SEM FK para usuario/convite
//     vinculadas apenas via setorId (agregacao por GHE)
// ============================================================

// ---- Setor / GHE (Grupo Homogeneo de Exposicao) ----
model NR1Setor {
  id        String   @id @default(cuid())
  companyId String
  nome      String   // ex: "Financeiro", "RH", "Operacoes"
  perfilDiscDominante String?  // D | I | S | C (opcional — alimenta cruzamento de recomendacoes)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  convites   NR1Convite[]
  respostas  NR1Resposta[]

  @@unique([companyId, nome])
  @@index([companyId])
}

// ---- Coleta / Campanha de avaliacao ----
model NR1Coleta {
  id          String    @id @default(cuid())
  companyId   String
  nome        String    // ex: "Diagnostico Psicossocial Q4 2026"
  status      String    @default("ACTIVE")  // ACTIVE | CLOSED
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  convites   NR1Convite[]
  respostas  NR1Resposta[]
  relatorios NR1Relatorio[]

  @@index([companyId])
  @@index([status])
}

// ---- Tabela A: Convite com identidade (controle) ----
model NR1Convite {
  id        String   @id @default(cuid())
  coletaId  String
  setorId   String
  companyId String
  nome      String
  email     String
  token     String   @unique
  status    String   @default("PENDING")  // PENDING | COMPLETED | EXPIRED
  completedAt DateTime?
  createdAt DateTime @default(now())

  coleta  NR1Coleta @relation(fields: [coletaId], references: [id], onDelete: Cascade)
  setor   NR1Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)
  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([coletaId])
  @@index([setorId])
  @@index([companyId])
  @@index([status])
}

// ---- Tabela B: Respostas ANONIMAS (sem FK de identidade) ----
model NR1Resposta {
  id          String   @id @default(cuid())
  coletaId    String   // FK para agregacao por coleta
  setorId     String   // FK para agregacao por GHE
  companyId   String   // redundancia para query rapida
  instrumento String   // KARASEK | ERI | COPSOQ
  respostas   String   @db.Text  // JSON com {questaoId: valor} bruto
  scores      String   @db.Text  // JSON com scores calculados (matriz Karasek, razao ERI, dimensoes COPSOQ 0-100)
  createdAt   DateTime @default(now())
  // ATENCAO: sem FK para Employee/User/NR1Convite — anonimato blindado

  coleta  NR1Coleta @relation(fields: [coletaId], references: [id], onDelete: Cascade)
  setor   NR1Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)
  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([coletaId])
  @@index([setorId])
  @@index([companyId])
  @@index([instrumento])
}

// ---- Relatorio agregado por coleta ----
model NR1Relatorio {
  id           String   @id @default(cuid())
  coletaId     String   @unique
  companyId    String
  status       String   @default("PENDING")  // PENDING | GENERATING | COMPLETED | FAILED
  content      String?  @db.Text  // JSON com agregacoes, heatmap, recomendacoes
  pdfUrl       String?  // URL do PDF no Supabase Storage
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coleta  NR1Coleta @relation(fields: [coletaId], references: [id], onDelete: Cascade)
  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}

// ============================================================
// ASSINATURA B2B (monetizacao PJ)
// 3 planos: ESSENCIAL (R$ 497, ate 10 func) · PROFISSIONAL (R$ 990, ate 50)
//           · ENTERPRISE (custom, acima de 50)
// Trial: 7 dias gratuitos SEM cartao na ativacao.
// Quando ativa, libera: NR-1 + Guia de Entrevista + Testes ilimitados (sem
// descontar creditos da Company).
// ============================================================

model Subscription {
  id                   String   @id @default(cuid())
  companyId            String   @unique  // 1 assinatura por empresa
  plan                 String   // ESSENCIAL | PROFISSIONAL | ENTERPRISE
  status               String   // TRIALING | ACTIVE | PAST_DUE | CANCELED | EXPIRED
  source               String   @default("STRIPE") // STRIPE | TRIAL_INTERNO | MANUAL
  stripeCustomerId     String?  // criado quando user vira pagante
  stripeSubscriptionId String?  @unique // criado no checkout
  trialStart           DateTime?
  trialEnd             DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

// ============================================================
// TRIAL LEAD — degustação via QR Code (palestras / rodadas de negócio)
// Captura nome + WhatsApp na entrada, cria testes anônimos numa
// empresa-vitrine e rastreia a conversão em cadastro pago/trial.
// ============================================================
model TrialLead {
  id                 String    @id @default(cuid())
  firstName          String
  whatsapp           String
  src                String?   // etiqueta do evento (?src=palestra-osasco-jul26)
  testTypes          String    // CSV dos testes escolhidos (ex.: "DISC,QI")
  bundleId           String?   // agrupa os assessments de degustação
  firstToken         String?   // token do 1º teste (link direto)
  status             String    @default("STARTED") // STARTED | CONVERTED
  convertedCompanyId String?   // empresa criada no cadastro (se converteu)
  createdAt          DateTime  @default(now())
  convertedAt        DateTime?

  @@index([src])
  @@index([status])
  @@index([bundleId])
}

// ============================================================
// GESTAO DE TIMES (20-70-10 + Team Build)
// Entidade compartilhada pelos dois modulos. Um TalentTeam agrupa
// membros (vinculados a um Employee com perfil OU avulsos). A partir
// do agrupamento, o gestor roda a Matriz de Talentos (20-70-10) e
// as ferramentas de Team Build (mapa de calor, dinamicas, manual).
// ============================================================

model TalentTeam {
  id          String   @id @default(cuid())
  companyId   String
  nome        String   // ex: "Time Comercial", "Squad Produto"
  descricao   String?  @db.Text
  // Fase atual do time (Tuckman) — usada pelo Team Build
  faseTuckman String?  // FORMING | STORMING | NORMING | PERFORMING
  // Lider do setor/time — alvo da Avaliacao de Lideranca ascendente
  liderNome  String?
  liderEmail String?
  // Hierarquia organizacional (organograma): equipe a qual esta responde.
  // Null = topo da arvore (ex: Diretoria). onDelete SetNull para nao apagar filhos.
  parentTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent  TalentTeam?   @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  children TalentTeam[] @relation("TeamHierarchy")
  members TalentMember[]
  liderConvites  LiderConvite[]
  liderRespostas LiderResposta[]

  @@index([companyId])
  @@index([parentTeamId])
}

model TalentMember {
  id          String   @id @default(cuid())
  teamId      String
  companyId   String   // redundancia para query rapida
  // Vinculo opcional a um Employee ja avaliado (traz o perfil DISC).
  // Quando null, e um membro avulso com "fit comportamental pendente".
  employeeId  String?
  nome        String
  cargo       String?
  // Email do membro (avulso). Quando ha employeeId, usa o email do Employee.
  email       String?
  // Perfil comportamental dominante (D | I | S | C). Preenchido a partir
  // do Employee vinculado ou informado manualmente pelo gestor.
  perfilDisc  String?
  // Eixo X da matriz: nota de performance/entrega dada pelo gestor (0 a 10)
  notaPerformance Float?
  // Eixo Y da matriz: fit comportamental (0 a 10). Calculado ou manual.
  fitComportamental Float?
  // Potencial (0 a 10), camada 9-box. Calculado pelo questionário.
  potencial   Float?
  // Respostas + medias do questionario de avaliacao (JSON)
  avaliacaoJson String? @db.Text
  // Devolutiva aprofundada gerada por IA (markdown), persistida para reconsulta
  aiDevolutiva   String?   @db.Text
  aiDevolutivaEm DateTime?
  // Zona na curva de vitalidade: TOP20 | MID70 | BOTTOM10
  zona        String?
  // Override manual: true quando o gestor arrastou e fixou a zona,
  // ignorando a sugestao algoritmica.
  zonaManual  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team  TalentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pdis  TalentPDI[]

  @@index([teamId])
  @@index([companyId])
  @@index([employeeId])
}

// Plano de Desenvolvimento Individual (esteira 20-70-10, Fase 2/3)
model TalentPDI {
  id          String   @id @default(cuid())
  memberId    String
  companyId   String
  // Feedback SCI estruturado (preenchido na Tela 2)
  sciSituacao     String? @db.Text
  sciComportamento String? @db.Text
  sciImpacto      String? @db.Text
  // Acoes selecionadas (JSON array de strings)
  acoes       String?  @db.Text
  prazo       DateTime?
  frequencia  String?  // SEMANAL | QUINZENAL | MENSAL
  status      String   @default("ATIVO")  // ATIVO | CONCLUIDO | ATRASADO | ARQUIVADO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member   TalentMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkIns TalentCheckIn[]

  @@index([memberId])
  @@index([companyId])
  @@index([status])
}

// Check-in de acompanhamento na timeline (Tela 4)
model TalentCheckIn {
  id          String   @id @default(cuid())
  pdiId       String
  companyId   String
  nota        String   @db.Text  // anotacao curta do gestor
  statusMeta  String   @default("EM_ANDAMENTO")  // EM_ANDAMENTO | CONCLUIDO | EM_ATRASO
  tendencia   String?  // SUBINDO | ESTAVEL | DESCENDO (rumo aos 20%)
  createdAt   DateTime @default(now())

  pdi TalentPDI @relation(fields: [pdiId], references: [id], onDelete: Cascade)

  @@index([pdiId])
  @@index([companyId])
}

// ============================================================
// AVALIACAO DE LIDERANCA (ascendente, anonima)
// Liderados avaliam o lider do time. Mesmo padrao de anonimato
// blindado do NR-1: Tabela A (convite com identidade, so controle)
// e Tabela B (respostas SEM FK de identidade). Resultado agregado
// exige n minimo de 3 respostas.
// ============================================================

// ---- Tabela A: Convite com identidade (controle de quem ja respondeu) ----
model LiderConvite {
  id          String    @id @default(cuid())
  teamId      String
  companyId   String
  nome        String
  email       String
  token       String    @unique
  status      String    @default("PENDING")  // PENDING | COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  team    TalentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([teamId])
  @@index([companyId])
  @@index([status])
}

// ---- Tabela B: Respostas ANONIMAS (sem FK de convite/membro) ----
model LiderResposta {
  id        String   @id @default(cuid())
  teamId    String
  companyId String
  respostas String   @db.Text  // JSON {perguntaId: 1..5}
  scores    String   @db.Text  // JSON {scoreFinal, pilares}
  sciTexto  String?  @db.Text  // relato SCI anonimo (Situacao, Comportamento, Impacto)
  // HMAC irreversivel de IP+UserAgent: detecta respostas repetidas do
  // mesmo dispositivo (antifraude) sem identificar o respondente
  deviceHash String?
  createdAt DateTime @default(now())
  // ATENCAO: sem FK para LiderConvite/TalentMember — anonimato blindado

  team    TalentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([companyId])
}

// ============================================================
// AVALIACAO 360 GRAUS (multiavaliador)
// Uma pessoa (avaliado) e avaliada por si (AUTO), GESTOR, PARES e
// SUBORDINADOS. Mesmo anonimato blindado: o convite guarda identidade
// + papel; a resposta guarda so o papel + dados, ligada ao CICLO e
// nunca ao convite. Pares/subordinados aparecem so agregados.
// companyId/teamId sao escalares; as FKs (cascade/setnull) ficam no
// SQL da migration para nao alterar os modelos Company/TalentTeam.
// ============================================================

model Avaliacao360 {
  id            String   @id @default(cuid())
  companyId     String
  teamId        String?
  avaliadoNome  String
  avaliadoEmail String?
  titulo        String?  // ex: "360 Q3 2026"
  status        String   @default("ACTIVE")  // ACTIVE | CLOSED
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  convites  Avaliacao360Convite[]
  respostas Avaliacao360Resposta[]

  @@index([companyId])
  @@index([teamId])
}

// ---- Convite com identidade + papel (controle de quem respondeu) ----
model Avaliacao360Convite {
  id          String    @id @default(cuid())
  avaliacaoId String
  companyId   String
  role        String    // AUTO | GESTOR | PAR | SUBORDINADO
  nome        String
  email       String
  token       String    @unique
  status      String    @default("PENDING")  // PENDING | COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  avaliacao Avaliacao360 @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@index([avaliacaoId])
  @@index([companyId])
  @@index([status])
}

// ---- Resposta ANONIMA (ligada ao ciclo + papel, sem FK de convite) ----
model Avaliacao360Resposta {
  id             String   @id @default(cuid())
  avaliacaoId    String
  companyId      String
  role           String   // AUTO | GESTOR | PAR | SUBORDINADO
  respostas      String   @db.Text  // JSON {perguntaId: 1..5}
  scores         String   @db.Text  // JSON {scoreFinal, pilares}
  continuarTexto String?  @db.Text
  melhorarTexto  String?  @db.Text
  deviceHash     String?
  createdAt      DateTime @default(now())
  // ATENCAO: sem FK para o convite — anonimato blindado

  avaliacao Avaliacao360 @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@index([avaliacaoId])
  @@index([companyId])
  @@index([role])
}

// ============================================================
// eNPS (Employee Net Promoter Score) — pesquisa de clima anônima
// Mesmo anonimato do NR-1: coleta + convite (controle) + resposta
// anônima (nota 0-10, motivo, tempo de casa), sem FK de identidade.
// ============================================================

model EnpsColeta {
  id        String   @id @default(cuid())
  companyId String
  titulo    String?
  status    String   @default("ACTIVE")  // ACTIVE | CLOSED
  expiresAt DateTime
  createdAt DateTime @default(now())

  convites  EnpsConvite[]
  respostas EnpsResposta[]

  @@index([companyId])
}

model EnpsConvite {
  id          String    @id @default(cuid())
  coletaId    String
  companyId   String
  nome        String
  email       String
  token       String    @unique
  status      String    @default("PENDING")  // PENDING | COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  coleta EnpsColeta @relation(fields: [coletaId], references: [id], onDelete: Cascade)

  @@index([coletaId])
  @@index([companyId])
  @@index([status])
}

model EnpsResposta {
  id         String   @id @default(cuid())
  coletaId   String
  companyId  String
  nota       Int      // 0 a 10
  categoria  String   // PROMOTOR | NEUTRO | DETRATOR
  tempoCasa  String?  // ATE_3M | DE_3M_1A | DE_1A_2A | MAIS_2A
  motivo     String?  @db.Text
  deviceHash String?
  createdAt  DateTime @default(now())
  // ATENCAO: sem FK para o convite — anonimato blindado

  coleta EnpsColeta @relation(fields: [coletaId], references: [id], onDelete: Cascade)

  @@index([coletaId])
  @@index([companyId])
}

// ============================================================
// DIAGNOSTICO DE LIDERANCA PME (lead gen, publico, sem login)
// Fluxo em cascata: o Dono responde, gera um token para o Lider
// responder, e o sistema cruza os dados gerando os gaps.
// ============================================================
model PmeDiagnostico {
  id            String   @id @default(cuid())
  // Lead (dono)
  donoNome      String
  donoEmail     String
  donoTelefone  String?
  empresa       String
  funcionarios  String?  // faixa: 1-5 | 6-20 | 21-50 | 50+
  temLideres    Boolean  @default(false)
  // Respostas
  respostasDono  String  @db.Text  // JSON { questaoId: valor }
  respostasLider String? @db.Text  // JSON, preenchido quando o lider responde
  // Acesso do lider
  tokenLider    String   @unique
  liderNome     String?
  liderEmail    String?
  // Resultado calculado
  scoreMaturidade Int?            // 0 a 100
  cenario         String?         // DONO_SOLITARIO | LIDERANCA_DESALINHADA | LIDERANCA_ALINHADA
  relatorioAi     String? @db.Text // narrativa gerada (persistida)
  // Estado
  status        String   @default("DONO_RESPONDEU") // DONO_RESPONDEU | COMPLETO
  liderRespondeuEm DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([donoEmail])
}
